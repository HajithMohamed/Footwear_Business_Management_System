# The application must be served from /public. If a hosting account accidentally
# points a domain at the repository root, deny access rather than expose code,
# configuration, SQL files, or storage.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Deny from all
</IfModule>

Options -Indexes
