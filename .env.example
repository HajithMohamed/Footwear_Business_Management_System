# ------------------------------------------------------------------
# Copy this file to ".env" and replace every placeholder with your hosting values.
# Do not commit .env. These production-safe defaults deliberately contain no credentials.
# ------------------------------------------------------------------

# Application
APP_NAME="Shoe Bank"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://YOUR-DOMAIN.com
APP_TIMEZONE=Asia/Colombo

# Database (MySQL / MariaDB)
DB_HOST=YOUR_DATABASE_HOST
DB_PORT=3306
DB_NAME=YOUR_DATABASE_NAME
DB_USER=YOUR_DATABASE_USERNAME
DB_PASS=YOUR_DATABASE_PASSWORD

# Sessions
SESSION_NAME=footwear_erp_session
SESSION_LIFETIME=120     # minutes

# Uploads
UPLOAD_MAX_IMAGE_MB=8
UPLOAD_MAX_PDF_MB=15
IMAGE_MAX_EDGE=1600      # px, longest edge for stored originals
IMAGE_THUMB_EDGE=400     # px, thumbnail longest edge
