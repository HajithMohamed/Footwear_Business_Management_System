# ------------------------------------------------------------------
# Copy this file to ".env" and fill in your real values.
# On cPanel shared hosting, set these to your database credentials.
# ------------------------------------------------------------------

# Application
APP_NAME="Footwear Wholesale ERP"
APP_ENV=local            # local | production
APP_DEBUG=true           # set to false in production
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Colombo

# Database (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=footwear_erp
DB_USER=root
DB_PASS=

# Sessions
SESSION_NAME=footwear_erp_session
SESSION_LIFETIME=120     # minutes

# Uploads
UPLOAD_MAX_IMAGE_MB=8
UPLOAD_MAX_PDF_MB=15
IMAGE_MAX_EDGE=1600      # px, longest edge for stored originals
IMAGE_THUMB_EDGE=400     # px, thumbnail longest edge
