# ------------------------------------------------------------------
# Copy this file to ".env" and replace every placeholder with your hosting values.
# Do not commit .env. These production-safe defaults deliberately contain no credentials.
# ------------------------------------------------------------------

# Application
APP_NAME="Shoe Bank"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://YOUR-DOMAIN.com
APP_TIMEZONE=Asia/Colombo

# Docker/Caddy production domain and TLS notification address
APP_DOMAIN=YOUR-DOMAIN.com
CADDY_EMAIL=YOUR_EMAIL@example.com

# Database (MySQL / MariaDB)
DB_HOST=YOUR_DATABASE_HOST
DB_PORT=3306
DB_DATABASE=YOUR_DATABASE_NAME
DB_USERNAME=YOUR_DATABASE_USERNAME
DB_PASSWORD=YOUR_DATABASE_PASSWORD

# MySQL container initialization. For Docker production, these values are used
# to populate DB_DATABASE, DB_USERNAME and DB_PASSWORD inside the app container.
MYSQL_DATABASE=YOUR_DATABASE_NAME
MYSQL_USER=YOUR_DATABASE_USERNAME
MYSQL_PASSWORD=YOUR_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=YOUR_LONG_RANDOM_ROOT_PASSWORD

# Legacy aliases (DB_NAME, DB_USER and DB_PASS) remain supported for existing
# Docker/local installations, but use the DB_* names above for new deployments.

# Sessions
SESSION_NAME=footwear_erp_session
SESSION_LIFETIME=120     # minutes

# Uploads
UPLOAD_MAX_IMAGE_MB=8
UPLOAD_MAX_PDF_MB=15
IMAGE_MAX_EDGE=1600      # px, longest edge for stored originals
IMAGE_THUMB_EDGE=400     # px, thumbnail longest edge
